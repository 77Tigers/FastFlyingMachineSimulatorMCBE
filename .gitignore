/target/
/target-*/
/dist/
# Local credentials and machine configuration (sanitized templates may be tracked).
.env
.env.*
!.env.example
!.env.sample
!.env.template
id_rsa
id_ed25519
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.flyer
# Keep verified bank entries under version control.
!/flyers/bank/**/*.flyer
# Extension-bank contracts reference their candidate.flyer by relative path.
!/flyers/extension_bank/**/*.flyer
# Fast-simulator regression cases (fastsim/tests/equivalence.rs).
!/fastsim/regressions/*.flyer
/viewer/node_modules/
/viewer/.npm-cache/
# Keep compiled artifacts local, including archived research executables.
*.exe
*.pdb
*.dll
*.so
*.dylib
*.a
*.lib
*.rlib
*.rmeta
*.exp
*.o
*.obj
*.wasm
/flyers/WIP/experiments/bin/
*.pkl
*.zip
*.7z
# Generated research output: keep summaries (CSV/JSON/FINDINGS) next to the
# generator and send bulk runs, traces and logs to an ignored out/ directory.
/flyers/WIP/**/out/
# Per-candidate scratch fixtures written by extract.py (regenerable; summarised
# in the experiment's REPORT.md / state.json).
/flyers/WIP/experiments/**/extract/work/
# Full 80-sample interleaved result dumps (2-19 MB each); regenerable with
# `extension_contract.py --samples`. Keep only the small samples_*_natural.json.
/flyers/extension_bank/**/samples_interleaved.json
/flyers/WIP/experiments/**/samples_interleaved.json
/flyers/WIP/experiments/**/samples_exact_interleaved.json
# Per-sample before/after results for the generated n3 candidates (verdicts are in
# each NOTES.md and flyers/WIP/experiments/pl11_3bps_*/catalogue.json).
/flyers/extension_bank/n3/*/samples_*_natural.json
# 2026-10-15: no per-sample dumps in the bank at all (verdicts are in index.json orders_80_samples).
/flyers/extension_bank/**/samples_*.json
*.out
*.err
/tools/target/
*.egg-info/
# Bulk enumeration output (summarised in REPORT.md)
/flyers/WIP/experiments/topology_20261007/runs/enum_*.json

# contract solver: regenerable benchmark outputs
flyers/WIP/experiments/contract_solver_20261014/runs/
flyers/WIP/experiments/contract_solver_20261014/flyerprobs/
flyers/WIP/experiments/contract_solver_20261014/problems/
/target-dev
flyers/WIP/experiments/contract_solver_20261014/scratch/
flyers/WIP/experiments/contract_solver_20261014/flyerprobs_ext/
flyers/WIP/experiments/contract_solver_20261014/flyerprobs_bare/
# contract solver design experiments: regenerable solver runs / logs (keep design.flyer + verify/solution.flyer)
/flyers/WIP/experiments/contract_solver_20261014/designs/*.log
/flyers/WIP/experiments/contract_solver_20261014/designs/*/bare_*/
/flyers/WIP/experiments/contract_solver_20261014/designs/*/probs/
